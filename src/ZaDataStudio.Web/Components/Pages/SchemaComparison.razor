@page "/schema-comparison"
@rendermode InteractiveServer

<PageTitle>SQL Server Schema Comparison</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>SQL Server Schema Comparison</h1>
    <div class="btn-group">
        <button class="btn btn-outline-primary" @onclick="ToggleSaveDialog">
            <span class="bi bi-save me-1"></span>
            Save Session
        </button>
        <button class="btn btn-outline-secondary" @onclick="ToggleLoadDialog">
            <span class="bi bi-folder-open me-1"></span>
            Load Session
        </button>
    </div>
</div>

@if (showSaveDialog)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <span class="bi bi-save me-2"></span>
                Save Session
            </h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="sessionName" class="form-label">Session Name</label>
                <input type="text" 
                       id="sessionName" 
                       class="form-control" 
                       @bind="sessionName" 
                       placeholder="Enter a name for this session" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveSession">
                    <span class="bi bi-check-circle me-1"></span>
                    Save
                </button>
                <button class="btn btn-secondary" @onclick="ToggleSaveDialog">
                    Cancel
                </button>
            </div>
            @if (!string.IsNullOrEmpty(saveMessage))
            {
                <div class="alert alert-success mt-3 mb-0">
                    <span class="bi bi-check-circle me-1"></span>
                    @saveMessage
                </div>
            }
        </div>
    </div>
}

@if (showLoadDialog)
{
    <div class="card mb-4 border-secondary">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <span class="bi bi-folder-open me-2"></span>
                Load Session
            </h5>
        </div>
        <div class="card-body">
            @if (savedSessions.Any())
            {
                <div class="list-group">
                    @foreach (var session in savedSessions)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1">
                                    @session.DisplayName
                                    @if (session.SourceTestResult?.IsSuccessful == true && session.DestinationTestResult?.IsSuccessful == true)
                                    {
                                        <span class="badge bg-success ms-2">Connected</span>
                                    }
                                </h6>
                                <small class="text-muted">
                                    <div>Created: @session.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm") | Modified: @session.LastModified.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                    <div>
                                        <span class="bi bi-table me-1"></span>@session.TableMappings.Count mapping(s) 
                                        | <span class="bi bi-list-columns me-1"></span>@session.TableMappings.Sum(m => m.ColumnMappings.Count) column(s)
                                        @if (session.SourceTables.Any())
                                        {
                                            <span> | <span class="bi bi-database me-1"></span>@session.SourceTables.Count source table(s) loaded</span>
                                        }
                                    </div>
                                </small>
                            </div>
                            <div class="btn-group">
                                <button class="btn btn-sm btn-primary" @onclick="() => LoadSession(session.Id)">
                                    <span class="bi bi-upload me-1"></span>
                                    Load
                                </button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteSession(session.Id)">
                                    <span class="bi bi-trash"></span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center mb-0">
                    <span class="bi bi-info-circle me-2"></span>
                    No saved sessions found.
                </p>
            }
            <div class="mt-3">
                <button class="btn btn-secondary" @onclick="ToggleLoadDialog">
                    Close
                </button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(loadMessage))
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <span class="bi bi-check-circle me-2"></span>
        @loadMessage
        <button type="button" class="btn-close" @onclick="() => loadMessage = string.Empty"></button>
    </div>
}

<div class="row mb-4">
    <div class="col-12 mb-3">
        <button class="btn btn-primary" @onclick="TestBothConnections" disabled="@(isTestingSource || isTestingDest)">
            @if (isTestingSource || isTestingDest)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                <span>Testing Connections...</span>
            }
            else
            {
                <span class="bi bi-plug me-1"></span>
                <span>Test Both Connections</span>
            }
        </button>
    </div>
    
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Source Server</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="sourceConnection" class="form-label">Connection String</label>
                    <textarea 
                        id="sourceConnection" 
                        class="form-control" 
                        rows="3" 
                        @bind="sourceConnectionString"
                        placeholder="Server=localhost;Database=mydb;User Id=sa;Password=xxx;TrustServerCertificate=True"></textarea>
                </div>
                @if (sourceTestResult != null)
                {
                    <div class="mt-3">
                        @if (sourceTestResult.IsSuccessful)
                        {
                            <div class="alert alert-success py-2">
                                <strong><span class="bi bi-check-circle me-1"></span> Connected!</strong>
                                <div class="small mt-1">
                                    <div><strong>Server:</strong> @sourceTestResult.ServerName</div>
                                    <div><strong>Database:</strong> @sourceTestResult.DatabaseName</div>
                                    <div><strong>Response Time:</strong> @sourceTestResult.ResponseTime.ToString("F0") ms</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger py-2">
                                <strong><span class="bi bi-x-circle me-1"></span> Connection Failed</strong>
                                <div class="small mt-1">@sourceTestResult.ErrorMessage</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Destination Server</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="destConnection" class="form-label">Connection String</label>
                    <textarea 
                        id="destConnection" 
                        class="form-control" 
                        rows="3" 
                        @bind="destinationConnectionString"
                        placeholder="Server=localhost;Database=mydb2;User Id=sa;Password=xxx;TrustServerCertificate=True"></textarea>
                </div>
                @if (destTestResult != null)
                {
                    <div class="mt-3">
                        @if (destTestResult.IsSuccessful)
                        {
                            <div class="alert alert-success py-2">
                                <strong><span class="bi bi-check-circle me-1"></span> Connected!</strong>
                                <div class="small mt-1">
                                    <div><strong>Server:</strong> @destTestResult.ServerName</div>
                                    <div><strong>Database:</strong> @destTestResult.DatabaseName</div>
                                    <div><strong>Response Time:</strong> @destTestResult.ResponseTime.ToString("F0") ms</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger py-2">
                                <strong><span class="bi bi-x-circle me-1"></span> Connection Failed</strong>
                                <div class="small mt-1">@destTestResult.ErrorMessage</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (sourceTestResult?.IsSuccessful == true && destTestResult?.IsSuccessful == true)
{
    @if (showMultiSourceDialog)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">
                            <span class="bi bi-table me-2"></span>
                            Select Multiple Source Tables
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseMultiSourceDialog"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">Select additional source tables to map columns from:</p>
                        <div class="list-group" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var table in sourceTables)
                            {
                                var isSelected = currentMultiSourceTables.Contains(table);
                                <label class="list-group-item d-flex align-items-center">
                                    <input type="checkbox" 
                                           class="form-check-input me-2" 
                                           checked="@isSelected"
                                           @onchange="@((e) => ToggleMultiSourceTable(table, (bool)(e.Value ?? false)))" />
                                    <span>@table</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseMultiSourceDialog">Cancel</button>
                        <button class="btn btn-primary" @onclick="ApplyMultiSourceTables">
                            <span class="bi bi-check-circle me-1"></span>
                            Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card mb-4 border-success">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <span class="bi bi-file-earmark-excel me-2"></span>
                Excel-Based Advanced Mapping
            </h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong><span class="bi bi-lightbulb me-2"></span>Smart Mapping!</strong> 
                Use Excel to define data mappings with full metadata. Single sheet "DataMapping" with columns for:
                <strong>New schema</strong> (table, column, datatype, nullable, description), 
                <strong>Old schema</strong> (table, column, datatype, nullable), 
                and <strong>Status</strong> (mapping status, notes).
            </div>
            
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-primary" @onclick="DownloadExcelTemplate">
                    <span class="bi bi-download me-1"></span>
                    Download Excel Template
                </button>
                <label class="btn btn-success @(isUploadingExcel ? "disabled" : "")" style="@(isUploadingExcel ? "pointer-events: none;" : "")">
                    @if (isUploadingExcel)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Uploading...</span>
                    }
                    else
                    {
                        <span class="bi bi-upload me-1"></span>
                        <span>Upload Mapping Excel</span>
                    }
                    <InputFile OnChange="HandleExcelUpload" accept=".xlsx,.xls" style="display: none;" disabled="@isUploadingExcel" />
                </label>
            </div>

            @if (excelMappingConfig != null)
            {
                <div class="alert alert-success">
                    <strong><span class="bi bi-check-circle me-2"></span>Excel Mapping Loaded!</strong>
                    <ul class="mb-0 mt-2">
                        <li>@excelMappingConfig.ColumnMappings.Count column mapping(s)</li>
                        <li>@excelMappingConfig.GroupedByTable.Count table(s)</li>
                        <li>@excelMappingConfig.ColumnMappings.Count(m => m.MappingStatus == "Approved") approved mapping(s)</li>
                    </ul>
                    <div class="mt-2">
                        <button class="btn btn-sm btn-primary" @onclick="GenerateExcelSQL">
                            <span class="bi bi-file-code me-1"></span>
                            Generate Migration SQL
                        </button>
                        <button class="btn btn-sm btn-info ms-2" @onclick="GenerateValidationReport">
                            <span class="bi bi-clipboard-check me-1"></span>
                            Generate Validation Report
                        </button>
                        <button class="btn btn-sm btn-success ms-2" @onclick="LoadExcelMappingsToTables">
                            <span class="bi bi-arrow-down-circle me-1"></span>
                            Load to Table Mappings
                        </button>
                        <button class="btn btn-sm btn-warning ms-2" @onclick="CompareExcelMappings" disabled="@isComparingExcelMappings">
                            @if (isComparingExcelMappings)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Analyzing...</span>
                            }
                            else
                            {
                                <span class="bi bi-search me-1"></span>
                                <span>Analyze Excel Mappings</span>
                            }
                        </button>
                        @if (excelComparisonResult != null && !isComparingExcelMappings)
                        {
                            <button class="btn btn-sm btn-info ms-2" @onclick="DownloadAnalysisExcel" disabled="@isExportingAnalysisExcel">
                                @if (isExportingAnalysisExcel)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Exporting...</span>
                                }
                                else
                                {
                                    <span class="bi bi-file-earmark-spreadsheet me-1"></span>
                                    <span>Export Analysis to Excel</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(excelValidationReport))
            {
                <div class="card mt-3">
                    <div class="card-header bg-info text-white">
                        <strong>Validation Report</strong>
                    </div>
                    <div class="card-body">
                        <pre style="max-height: 300px; overflow-y: auto; background-color: #f8f9fa; padding: 15px; border-radius: 5px; white-space: pre-wrap; word-wrap: break-word;"><code>@excelValidationReport</code></pre>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(excelGeneratedSQL))
            {
                <div class="card mt-3">
                    <div class="card-header">
                        <strong>Generated SQL from Excel Mapping</strong>
                    </div>
                    <div class="card-body">
                        <pre style="max-height: 400px; overflow-y: auto; background-color: #f8f9fa; padding: 15px; border-radius: 5px; white-space: pre-wrap; word-wrap: break-word;"><code>@excelGeneratedSQL</code></pre>
                        <div class="mt-2">
                            <button class="btn btn-primary" @onclick="DownloadExcelSQL">
                                <span class="bi bi-download me-1"></span>
                                Download SQL
                            </button>
                            <button class="btn btn-outline-primary ms-2" @onclick="CopyExcelSQL">
                                <span class="bi bi-clipboard me-1"></span>
                                Copy to Clipboard
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (excelComparisonResult != null)
            {
                <div class="card mt-3 border-warning">
                    <div class="card-header bg-warning text-dark">
                        <h6 class="mb-0">
                            <span class="bi bi-clipboard-check me-2"></span>
                            Excel Mapping Analysis Results
                        </h6>
                    </div>
                    <div class="card-body">
                        @if (excelComparisonResult.LookupAnalysis.Any())
                        {
                            <h6 class="text-primary"><span class="bi bi-bookmark-star me-2"></span>Lookup Column Analysis</h6>
                            @foreach (var lookup in excelComparisonResult.LookupAnalysis)
                            {
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <strong>@lookup.TableName.@lookup.ColumnName</strong>
                                        <span class="badge bg-info ms-2">Lookup</span>
                                        @if (!string.IsNullOrEmpty(lookup.OldLookupSpec) || !string.IsNullOrEmpty(lookup.NewLookupSpec))
                                        {
                                            <span class="badge bg-secondary ms-2">Filtered</span>
                                        }
                                    </div>
                                    <div class="card-body">
                                        @if (!string.IsNullOrEmpty(lookup.OldLookupSpec) || !string.IsNullOrEmpty(lookup.NewLookupSpec))
                                        {
                                            <div class="alert alert-info mb-3">
                                                <strong><span class="bi bi-filter me-2"></span>Lookup Filter Specifications:</strong>
                                                @if (!string.IsNullOrEmpty(lookup.OldLookupSpec))
                                                {
                                                    <div class="mt-1"><strong>Old System:</strong> <code>@lookup.OldLookupSpec</code></div>
                                                }
                                                @if (!string.IsNullOrEmpty(lookup.NewLookupSpec))
                                                {
                                                    <div class="mt-1"><strong>New System:</strong> <code>@lookup.NewLookupSpec</code></div>
                                                }
                                            </div>
                                        }
                                        
                                        @if (lookup.LookupFilterMismatch)
                                        {
                                            <div class="alert alert-danger mb-3">
                                                <strong><span class="bi bi-exclamation-triangle me-2"></span>Lookup Filter Mismatch!</strong>
                                                <div class="mt-1">@lookup.LookupFilterMessage</div>
                                            </div>
                                        }
                                        
                                        <div class="row">
                                            <div class="col-md-6">
                                                <h6>Source: @lookup.SourceTable.@lookup.SourceColumn</h6>
                                                @if (!string.IsNullOrEmpty(lookup.OldLookupSpec))
                                                {
                                                    <p class="text-muted small">Filtered by: <code>@lookup.OldLookupSpec</code></p>
                                                }
                                                <p><strong>LookupQuery: </strong> @lookup.SourceLookupQuery</p>
                                                <p><strong>Distinct Values:</strong> @lookup.SourceDistinctCount</p>
                                                @if (lookup.SourceSampleValues.Any())
                                                {
                                                    <p><strong>Sample Values:</strong></p>
                                                    <ul class="small">
                                                        @foreach (var val in lookup.SourceSampleValues.Take(5))
                                                        {
                                                            <li>@val</li>
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                            <div class="col-md-6">
                                                <h6>Destination: @lookup.TableName.@lookup.ColumnName</h6>
                                                @if (!string.IsNullOrEmpty(lookup.NewLookupSpec))
                                                {
                                                    <p class="text-muted small">Filtered by: <code>@lookup.NewLookupSpec</code></p>
                                                }
                                                <p><strong>LookupQuery: </strong> @lookup.DestinationLookupQuery</p>
                                                <p><strong>Distinct Values:</strong> @lookup.DestinationDistinctCount</p>
                                                @if (lookup.DestinationSampleValues.Any())
                                                {
                                                    <p><strong>Sample Values:</strong></p>
                                                    <ul class="small">
                                                        @foreach (var val in lookup.DestinationSampleValues.Take(5))
                                                        {
                                                            <li>@val</li>
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                        </div>
                                        @if (lookup.MismatchedValues.Any())
                                        {
                                            <div class="alert alert-warning mt-2">
                                                <strong><span class="bi bi-exclamation-triangle me-2"></span>Mismatched Query: </strong>
                                                <strong>@lookup.AffectedRecordCountQuery</strong>
                                            </div>
                                            <div class="alert alert-warning mt-2">
                                                <strong><span class="bi bi-exclamation-triangle me-2"></span>Mismatched Values:</strong>
                                                <ul class="mb-0">
                                                    @foreach (var mismatch in lookup.MismatchedValues.Take(50))
                                                    {
                                                        <li>@mismatch</li>
                                                    }
                                                    @if (lookup.MismatchedValues.Count > 50)
                                                    {
                                                        <li class="text-muted">... and @(lookup.MismatchedValues.Count - 50) more</li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-success mt-2">
                                                <span class="bi bi-check-circle me-2"></span>
                                                All source values match destination values!
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        @if (excelComparisonResult.DatatypeComparisons.Any())
                        {
                            <h6 class="text-info mt-4"><span class="bi bi-file-earmark-diff me-2"></span>Datatype & Format Comparison</h6>
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Destination Column</th>
                                        <th>Source Column</th>
                                        <th>Source Type</th>
                                        <th>Dest Type</th>
                                        <th>Status</th>
                                        <th>Issues</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var comp in excelComparisonResult.DatatypeComparisons)
                                    {
                                        <tr class="@(comp.HasIssues ? "table-warning" : "")">
                                            <td>@comp.DestinationTable.@comp.DestinationColumn</td>
                                            <td>@comp.SourceTable.@comp.SourceColumn</td>
                                            <td><code>@comp.SourceDataType</code></td>
                                            <td><code>@comp.DestinationDataType</code></td>
                                            <td>
                                                @if (comp.HasIssues)
                                                {
                                                    <span class="badge bg-warning text-dark">Issues Found</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Compatible</span>
                                                }
                                            </td>
                                            <td>
                                                @if (comp.Issues.Any())
                                                {
                                                    <ul class="mb-0 small">
                                                        @foreach (var issue in comp.Issues)
                                                        {
                                                            <li>@issue</li>
                                                        }
                                                    </ul>
                                                }
                                                else
                                                {
                                                    <span class="text-success">✓ OK</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (!excelComparisonResult.LookupAnalysis.Any() && !excelComparisonResult.DatatypeComparisons.Any())
                        {
                            <div class="alert alert-info">
                                <span class="bi bi-info-circle me-2"></span>
                                No issues found in Excel mappings. All columns appear compatible.
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">
                <span class="bi bi-table me-2"></span>
                Manual Table Selection & Mapping
            </h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <button class="btn btn-info" @onclick="LoadTables" disabled="@isLoadingTables">
                    @if (isLoadingTables)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <span>Loading Tables...</span>
                    }
                    else
                    {
                        <span class="bi bi-arrow-clockwise me-1"></span>
                        <span>Load Tables</span>
                    }
                </button>
                @if (sourceTables.Any() || destinationTables.Any())
                {
                    <button class="btn btn-success btn-sm ms-2" @onclick="AutoMapTables">
                        <span class="bi bi-magic me-1"></span>
                        Auto-Map Matching Names
                    </button>
                    <button class="btn btn-primary btn-sm ms-2" @onclick="AddMapping">
                        <span class="bi bi-plus-circle me-1"></span>
                        Add Mapping
                    </button>
                }
                @if (tableMappings.Any())
                {
                    <span class="ms-3 text-muted">
                        @tableMappings.Count(m => m.IsSelected) of @tableMappings.Count table(s) selected
                    </span>
                    <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="SelectAllTables">
                        <span class="bi bi-check-all me-1"></span>Select All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="DeselectAllTables">
                        <span class="bi bi-x-square me-1"></span>Deselect All
                    </button>
                    <button class="btn btn-primary btn-sm ms-3" @onclick="GenerateManualMappingSQL">
                        <span class="bi bi-file-code me-1"></span>
                        Generate Migration SQL
                    </button>
                }
            </div>

            @if (sourceTables.Any() && destinationTables.Any() && !tableMappings.Any())
            {
                <div class="alert alert-info mt-3">
                    <span class="bi bi-info-circle me-2"></span>
                    <strong>Tables loaded!</strong> Found @sourceTables.Count source tables and @destinationTables.Count destination tables.
                    Click <strong>"Auto-Map Matching Names"</strong> to automatically create mappings, or <strong>"Add Mapping"</strong> to create manually.
                    @if (excelMappingConfig != null)
                    {
                        <br />
                        <span class="text-success mt-2 d-inline-block">
                            <span class="bi bi-file-earmark-excel me-1"></span>
                            Or use <strong>"Load to Table Mappings"</strong> in the Excel section above to import mappings from Excel.
                        </span>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(excelLoadMessage))
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    @excelLoadMessage
                    <button type="button" class="btn-close" @onclick="() => excelLoadMessage = string.Empty"></button>
                </div>
            }

            @if (tableMappings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px;"></th>
                                <th style="width: 50px;">
                                    <input type="checkbox" 
                                           @onchange="ToggleAllTableSelection" 
                                           checked="@(tableMappings.All(m => m.IsSelected))" />
                                </th>
                                <th>Source Table</th>
                                <th style="width: 100px;" class="text-center">
                                    <span class="bi bi-arrow-left-right"></span>
                                </th>
                                <th>Destination Table</th>
                                <th style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (mapping, index) in tableMappings.Select((m, i) => (m, i)))
                            {
                                <tr class="@(mapping.IsSelected ? "" : "table-secondary")">
                                    <td class="text-center align-middle">
                                        <button class="btn btn-sm btn-link p-0" 
                                                @onclick="() => ToggleTableExpansion(index)"
                                                disabled="@((!mapping.GetAllSourceTables().Any()) || string.IsNullOrEmpty(mapping.DestinationTable))">
                                            <span class="bi @(expandedTableIndices.Contains(index) ? "bi-chevron-down" : "bi-chevron-right")"></span>
                                        </button>
                                    </td>
                                    <td class="text-center">
                                        <input type="checkbox" @bind="mapping.IsSelected" />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm mb-1" 
                                                value="@mapping.SourceTable"
                                                @onchange="@((e) => HandleSourceTableChange(index, e.Value?.ToString() ?? string.Empty))">
                                            <option value="">-- Select Primary Source Table --</option>
                                            @foreach (var table in sourceTables)
                                            {
                                                <option value="@table">@table</option>
                                            }
                                        </select>
                                        @if (mapping.SourceTables.Any())
                                        {
                                            <div class="badge bg-info text-wrap text-start" style="font-size: 0.75rem;">
                                                @string.Join(", ", mapping.SourceTables)
                                            </div>
                                        }
                                        <button class="btn btn-outline-secondary btn-sm mt-1 w-100" 
                                                @onclick="() => ShowMultiSourceDialog(index)"
                                                type="button">
                                            <span class="bi bi-plus-circle me-1"></span>
                                            Add More Source Tables
                                        </button>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="bi bi-arrow-right text-muted"></span>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="mapping.DestinationTable">
                                            <option value="">-- Select Destination Table --</option>
                                            @foreach (var table in destinationTables)
                                            {
                                                <option value="@table">@table</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn @(mapping.CompareData ? "btn-success" : "btn-outline-secondary")" 
                                                    @onclick="() => mapping.CompareData = !mapping.CompareData"
                                                    title="Compare Data">
                                                <span class="bi bi-database"></span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                
                                @if (expandedTableIndices.Contains(index))
                                {
                                    <tr>
                                        <td colspan="6" class="p-0">
                                            <div class="bg-light p-3 border-top">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <h6 class="mb-0">
                                                        <span class="bi bi-list-columns me-2"></span>
                                                        Column Mappings: @mapping.SourceTable → @mapping.DestinationTable
                                                    </h6>
                                                    <div>
                                                        <button class="btn btn-info btn-sm" 
                                                                @onclick="() => LoadColumnsForTable(index)" 
                                                                disabled="@(loadingColumnsForTable == index)">
                                                            @if (loadingColumnsForTable == index)
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                                <span>Loading...</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="bi bi-arrow-clockwise me-1"></span>
                                                                <span>Load Columns</span>
                                                            }
                                                        </button>
                                                        @if (mapping.AvailableSourceColumns.Any() || mapping.AvailableDestinationColumns.Any())
                                                        {
                                                            <button class="btn btn-success btn-sm ms-2" @onclick="() => AutoMapColumnsForTable(index)">
                                                                <span class="bi bi-magic me-1"></span>
                                                                Auto-Map
                                                            </button>
                                                            <button class="btn btn-primary btn-sm ms-2" @onclick="() => AddColumnMappingForTable(index)">
                                                                <span class="bi bi-plus-circle me-1"></span>
                                                                Add Column
                                                            </button>
                                                        }
                                                    </div>
                                                </div>

                                                @if (mapping.AvailableSourceColumns.Any() && mapping.AvailableDestinationColumns.Any() && !mapping.ColumnMappings.Any())
                                                {
                                                    <div class="alert alert-info alert-sm">
                                                        <span class="bi bi-info-circle me-2"></span>
                                                        <strong>Columns loaded!</strong> Found @mapping.AvailableSourceColumns.Count source columns and @mapping.AvailableDestinationColumns.Count destination columns.
                                                        Click <strong>"Auto-Map"</strong> to automatically map columns, or <strong>"Add Column"</strong> to map manually.
                                                    </div>
                                                }

                                                @if (mapping.ColumnMappings.Any())
                                                {
                                                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                                        <table class="table table-sm table-bordered mb-0">
                                                            <thead class="table-light sticky-top">
                                                                <tr>
                                                                    <th style="width: 150px;">Source Table</th>
                                                                    <th>Source Column</th>
                                                                    <th style="width: 50px;" class="text-center">
                                                                        <span class="bi bi-arrow-right"></span>
                                                                    </th>
                                                                    <th>Destination Column</th>
                                                                    <th style="width: 80px;" class="text-center">Key Column</th>
                                                                    <th style="width: 60px;" class="text-center">Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var (colMapping, colIndex) in mapping.ColumnMappings.Select((m, i) => (m, i)))
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            <select class="form-select form-select-sm" 
                                                                                    value="@colMapping.SourceTable"
                                                                                    @onchange="@((e) => OnSourceTableColumnChange(index, colIndex, e.Value?.ToString() ?? string.Empty))">
                                                                                <option value="">-- Select Table --</option>
                                                                                @foreach (var srcTable in mapping.GetAllSourceTables())
                                                                                {
                                                                                    <option value="@srcTable">@srcTable</option>
                                                                                }
                                                                            </select>
                                                                        </td>
                                                                        <td>
                                                                            <select class="form-select form-select-sm" @bind="colMapping.SourceColumn">
                                                                                <option value="">-- Select Column --</option>
                                                                                @if (!string.IsNullOrEmpty(colMapping.SourceTable) && tableColumnCache.ContainsKey(colMapping.SourceTable))
                                                                                {
                                                                                    @foreach (var col in tableColumnCache[colMapping.SourceTable])
                                                                                    {
                                                                                        <option value="@col">@col</option>
                                                                                    }
                                                                                }
                                                                                else
                                                                                {
                                                                                    @foreach (var col in mapping.AvailableSourceColumns)
                                                                                    {
                                                                                        <option value="@col">@col</option>
                                                                                    }
                                                                                }
                                                                            </select>
                                                                        </td>
                                                                        <td class="text-center align-middle">
                                                                            <span class="bi bi-arrow-right text-muted"></span>
                                                                        </td>
                                                                        <td>
                                                                            <select class="form-select form-select-sm" @bind="colMapping.DestinationColumn">
                                                                                <option value="">-- Select Column --</option>
                                                                                @foreach (var col in mapping.AvailableDestinationColumns)
                                                                                {
                                                                                    <option value="@col">@col</option>
                                                                                }
                                                                            </select>
                                                                        </td>
                                                                        <td class="text-center align-middle">
                                                                            <input type="checkbox" @bind="colMapping.IsKey" />
                                                                        </td>
                                                                        <td class="text-center">
                                                                            <button class="btn btn-sm btn-outline-danger" 
                                                                                    @onclick="() => RemoveColumnMappingForTable(index, colIndex)">
                                                                                <span class="bi bi-trash"></span>
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else if (!mapping.AvailableSourceColumns.Any() && !mapping.AvailableDestinationColumns.Any())
                                                {
                                                    <div class="alert alert-info alert-sm mb-0">
                                                        <span class="bi bi-info-circle me-2"></span>
                                                        Click <strong>"Load Columns"</strong> to load available columns for mapping.
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                
                <div class="d-flex gap-2">
                    <button class="btn btn-success btn-sm" @onclick="AddMapping">
                        <span class="bi bi-plus-circle me-1"></span>
                        Add Mapping
                    </button>
                    <button class="btn btn-danger btn-sm" @onclick="RemoveUnselectedMappings">
                        <span class="bi bi-trash me-1"></span>
                        Remove Unselected
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="AutoMapTables">
                        <span class="bi bi-magic me-1"></span>
                        Auto-Map Matching Names
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(manualMappingGeneratedSQL))
            {
                <div class="card mt-3 border-success">
                    <div class="card-header bg-success text-white">
                        <strong><span class="bi bi-check-circle me-2"></span>Generated Migration SQL from Table Mappings</strong>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-3">
                            <span class="bi bi-info-circle me-2"></span>
                            <strong>Migration SQL Ready!</strong> This SQL is generated from your table and column mappings.
                            @if (excelMappingConfig != null)
                            {
                                <span>Includes mappings loaded from Excel.</span>
                            }
                        </div>
                        <pre style="max-height: 400px; overflow-y: auto; background-color: #f8f9fa; padding: 15px; border-radius: 5px; white-space: pre-wrap; word-wrap: break-word;"><code>@manualMappingGeneratedSQL</code></pre>
                        <div class="mt-2">
                            <button class="btn btn-primary" @onclick="DownloadManualMappingSQL">
                                <span class="bi bi-download me-1"></span>
                                Download SQL
                            </button>
                            <button class="btn btn-outline-primary ms-2" @onclick="CopyManualMappingSQL">
                                <span class="bi bi-clipboard me-1"></span>
                                Copy to Clipboard
                            </button>
                            <button class="btn btn-outline-danger ms-2" @onclick="() => manualMappingGeneratedSQL = string.Empty">
                                <span class="bi bi-x-circle me-1"></span>
                                Clear
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (showColumnMapping && currentMappingIndex >= 0 && currentMappingIndex < tableMappings.Count)
{
    var currentMapping = tableMappings[currentMappingIndex];
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <span class="bi bi-list-columns me-2"></span>
                Column Mapping: @currentMapping.SourceTable → @currentMapping.DestinationTable
            </h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <button class="btn btn-info btn-sm" @onclick="LoadColumns" disabled="@isLoadingColumns">
                    @if (isLoadingColumns)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Loading...</span>
                    }
                    else
                    {
                        <span class="bi bi-arrow-clockwise me-1"></span>
                        <span>Load Columns</span>
                    }
                </button>
                @if (availableSourceColumns.Any() || availableDestinationColumns.Any())
                {
                    <button class="btn btn-success btn-sm ms-2" @onclick="AutoMapColumns">
                        <span class="bi bi-magic me-1"></span>
                        Auto-Map Matching Names
                    </button>
                    <button class="btn btn-primary btn-sm ms-2" @onclick="AddColumnMapping">
                        <span class="bi bi-plus-circle me-1"></span>
                        Add Column
                    </button>
                }
            </div>

            @if (availableSourceColumns.Any() && availableDestinationColumns.Any() && !currentMapping.ColumnMappings.Any())
            {
                <div class="alert alert-info">
                    <span class="bi bi-info-circle me-2"></span>
                    <strong>Columns loaded!</strong> Found @availableSourceColumns.Count source columns and @availableDestinationColumns.Count destination columns.
                    Click <strong>"Auto-Map Matching Names"</strong> to automatically map columns, or <strong>"Add Column"</strong> to map manually.
                </div>
            }

            @if (currentMapping.ColumnMappings.Any())
            {
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Source Column</th>
                                <th style="width: 50px;" class="text-center">
                                    <span class="bi bi-arrow-right"></span>
                                </th>
                                <th>Destination Column</th>
                                <th style="width: 80px;" class="text-center">Key Column</th>
                                <th style="width: 60px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (colMapping, colIndex) in currentMapping.ColumnMappings.Select((m, i) => (m, i)))
                            {
                                <tr>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="colMapping.SourceColumn">
                                            <option value="">-- Select Column --</option>
                                            @foreach (var col in availableSourceColumns)
                                            {
                                                <option value="@col">@col</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="bi bi-arrow-right text-muted"></span>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="colMapping.DestinationColumn">
                                            <option value="">-- Select Column --</option>
                                            @foreach (var col in availableDestinationColumns)
                                            {
                                                <option value="@col">@col</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-center align-middle">
                                        <input type="checkbox" @bind="colMapping.IsKey" />
                                    </td>
                                    <td class="text-center align-middle">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveColumnMapping(colIndex)" title="Remove">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-success btn-sm" @onclick="AddColumnMapping">
                        <span class="bi bi-plus-circle me-1"></span>
                        Add Column
                    </button>
                    <button class="btn btn-info btn-sm" @onclick="CompareColumnTypes" disabled="@isComparingColumnTypes">
                        @if (isComparingColumnTypes)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Comparing...</span>
                        }
                        else
                        {
                            <span class="bi bi-file-earmark-diff me-1"></span>
                            <span>Compare Datatypes</span>
                        }
                    </button>
                </div>
            }

            @if (columnTypeResult != null && columnTypeResult.HasDifferences)
            {
                <div class="alert alert-warning mt-3">
                    <h6><span class="bi bi-exclamation-triangle me-2"></span>Column Datatype Differences Found:</h6>
                    <table class="table table-sm table-bordered mt-2">
                        <thead>
                            <tr>
                                <th>Source Column</th>
                                <th>Source Type</th>
                                <th>Destination Column</th>
                                <th>Destination Type</th>
                                <th>Differences</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var diff in columnTypeResult.Differences)
                            {
                                <tr>
                                    <td>@diff.SourceColumn</td>
                                    <td><code>@diff.SourceType</code></td>
                                    <td>@diff.DestinationColumn</td>
                                    <td><code>@diff.DestinationType</code></td>
                                    <td>
                                        <ul class="mb-0">
                                            @foreach (var detail in diff.DifferenceDetails)
                                            {
                                                <li>@detail</li>
                                            }
                                        </ul>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (columnTypeResult != null && !columnTypeResult.HasDifferences)
            {
                <div class="alert alert-success mt-3">
                    <span class="bi bi-check-circle me-2"></span>
                    <strong>No datatype differences!</strong> All mapped columns have matching types.
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="CloseColumnMapping">
                    <span class="bi bi-check-circle me-1"></span>
                    Done
                </button>
                <button class="btn btn-secondary" @onclick="CloseColumnMapping">
                    Close
                </button>
            </div>
        </div>
    </div>
}

<div class="mb-4">
    <button class="btn btn-primary btn-lg" @onclick="CompareSchemas" disabled="@(!CanCompare)">
        @if (isComparing)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Comparing...</span>
        }
        else
        {
            <span class="bi bi-arrows-collapse me-2"></span>
            <span>Compare Schemas</span>
        }
    </button>
    <button class="btn btn-success btn-lg ms-2" @onclick="CompareData" disabled="@(!CanCompareData)">
        @if (isComparingData)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Comparing Data...</span>
        }
        else
        {
            <span class="bi bi-database me-2"></span>
            <span>Compare Data & Generate SQL</span>
        }

    </button>
    @if (!CanCompare && !isComparing)
    {
        <div class="text-muted small mt-2">
            <span class="bi bi-info-circle me-1"></span>
            @if (sourceTestResult?.IsSuccessful != true || destTestResult?.IsSuccessful != true)
            {
                <span>Please test both connections successfully before comparing.</span>
            }
            else if (!tableMappings.Any(m => m.IsSelected))
            {
                <span>Please select at least one table mapping to compare.</span>
            }
        </div>
    }
</div>



@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

@if (comparisonResult != null)
{
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">
                Comparison Results
                @if (!comparisonResult.HasDifferences)
                {
                    <span class="badge bg-success ms-2">Schemas Match</span>
                }
                else
                {
                    <span class="badge bg-warning ms-2">Differences Found</span>
                }
            </h4>
        </div>
        <div class="card-body">
            @if (comparisonResult.TablesOnlyInSource.Any())
            {
                <div class="mb-4">
                    <h5 class="text-primary">
                        <span class="bi bi-database-add me-2"></span>
                        Tables Only in Source (@comparisonResult.TablesOnlyInSource.Count)
                    </h5>
                    <ul class="list-group">
                        @foreach (var table in comparisonResult.TablesOnlyInSource)
                        {
                            <li class="list-group-item">@table</li>
                        }
                    </ul>
                </div>
            }

            @if (comparisonResult.TablesOnlyInDestination.Any())
            {
                <div class="mb-4">
                    <h5 class="text-success">
                        <span class="bi bi-database-add me-2"></span>
                        Tables Only in Destination (@comparisonResult.TablesOnlyInDestination.Count)
                    </h5>
                    <ul class="list-group">
                        @foreach (var table in comparisonResult.TablesOnlyInDestination)
                        {
                            <li class="list-group-item">@table</li>
                        }
                    </ul>
                </div>
            }

            @if (comparisonResult.TableDifferences.Any())
            {
                <div class="mb-4">
                    <h5 class="text-warning">
                        <span class="bi bi-exclamation-triangle me-2"></span>
                        Tables with Differences (@comparisonResult.TableDifferences.Count)
                    </h5>
                    
                    @foreach (var tableDiff in comparisonResult.TableDifferences)
                    {
                        <div class="card mb-3">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">@tableDiff.TableName</h6>
                            </div>
                            <div class="card-body">
                                @if (tableDiff.ColumnsOnlyInSource.Any())
                                {
                                    <div class="mb-3">
                                        <strong class="text-primary">Columns Only in Source:</strong>
                                        <ul>
                                            @foreach (var col in tableDiff.ColumnsOnlyInSource)
                                            {
                                                <li>@col</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (tableDiff.ColumnsOnlyInDestination.Any())
                                {
                                    <div class="mb-3">
                                        <strong class="text-success">Columns Only in Destination:</strong>
                                        <ul>
                                            @foreach (var col in tableDiff.ColumnsOnlyInDestination)
                                            {
                                                <li>@col</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (tableDiff.ColumnDifferences.Any())
                                {
                                    <div class="mb-3">
                                        <strong class="text-warning">Column Differences:</strong>
                                        <table class="table table-sm table-bordered mt-2">
                                            <thead>
                                                <tr>
                                                    <th>Column Name</th>
                                                    <th>Differences</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var colDiff in tableDiff.ColumnDifferences)
                                                {
                                                    <tr>
                                                        <td><code>@colDiff.Key</code></td>
                                                        <td>
                                                            <ul class="mb-0">
                                                                @foreach (var diff in colDiff.Value)
                                                                {
                                                                    <li>@diff</li>
                                                                }
                                                            </ul>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!comparisonResult.HasDifferences)
            {
                <div class="alert alert-success">
                    <span class="bi bi-check-circle me-2"></span>
                    <strong>Success!</strong> Both database schemas are identical.
                </div>
            }
        </div>
    </div>
}

@if (dataComparisonResults.Any())
{
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                <span class="bi bi-database me-2"></span>
                Data Comparison Results
            </h4>
        </div>
        <div class="card-body">
            @foreach (var result in dataComparisonResults)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">
                            @result.SourceTable → @result.DestinationTable
                            @if (result.IsLookupTable)
                            {
                                <span class="badge bg-info">Lookup Table</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(result.ErrorMessage))
                        {
                            <div class="alert alert-danger">
                                <strong>Error:</strong> @result.ErrorMessage
                            </div>
                        }
                        else
                        {
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-body">
                                            <h6>Source Rows: <strong>@result.SourceRowCount</strong></h6>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card">
                                        <div class="card-body">
                                            <h6>Destination Rows: <strong>@result.DestinationRowCount</strong></h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (result.RowsOnlyInSource.Any())
                            {
                                <div class="alert alert-warning">
                                    <strong><span class="bi bi-exclamation-triangle me-2"></span></strong>
                                    <strong>@result.RowsOnlyInSource.Count rows</strong> exist only in source (need INSERT)
                                </div>
                            }

                            @if (result.RowsWithDifferences.Any())
                            {
                                <div class="alert alert-info">
                                    <strong><span class="bi bi-info-circle me-2"></span></strong>
                                    <strong>@result.RowsWithDifferences.Count rows</strong> have differences (need UPDATE)
                                </div>
                            }

                            @if (result.RowsOnlyInDestination.Any())
                            {
                                <div class="alert alert-danger">
                                    <strong><span class="bi bi-trash me-2"></span></strong>
                                    <strong>@result.RowsOnlyInDestination.Count rows</strong> exist only in destination (orphaned data)
                                </div>
                            }

                            @if (result.IsLookupTable && result.SourceDistinctValues.Any())
                            {
                                <div class="mt-3">
                                    <h6>Distinct Values Analysis:</h6>
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Column</th>
                                                <th>Source Distinct</th>
                                                <th>Destination Distinct</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var (column, sourceCount) in result.SourceDistinctValues)
                                            {
                                                var destCount = result.DestinationDistinctValues.ContainsKey(column) 
                                                    ? result.DestinationDistinctValues[column] 
                                                    : 0;
                                                <tr>
                                                    <td>@column</td>
                                                    <td>@sourceCount</td>
                                                    <td class="@(sourceCount != destCount ? "bg-warning" : "")">@destCount</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (!result.HasDifferences)
                            {
                                <div class="alert alert-success">
                                    <span class="bi bi-check-circle me-2"></span>
                                    <strong>Data is in sync!</strong> No differences found.
                                </div>
                            }
                            else
                            {
                                <div class="mt-3">
                                    <button class="btn btn-primary" @onclick="() => DownloadMigrationSQL(result)">
                                        <span class="bi bi-download me-1"></span>
                                        Download Migration SQL
                                    </button>
                                    <button class="btn btn-outline-primary ms-2" @onclick="() => CopyMigrationSQL(result)">
                                        <span class="bi bi-clipboard me-1"></span>
                                        Copy to Clipboard
                                    </button>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}