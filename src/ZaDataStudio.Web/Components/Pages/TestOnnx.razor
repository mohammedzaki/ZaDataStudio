@page "/test-onnx"
@rendermode InteractiveServer

<PageTitle>ONNX Test</PageTitle>

<h3>🧪 ONNX Embedding Service Test</h3>

<div class="card mt-3">
    <div class="card-body">
        @if (!_tested)
        {
            <button class="btn btn-primary" @onclick="RunOnnxTest">
                @if (_testing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Run ONNX Test
            </button>
        }
        
        @if (_logs.Any())
        {
            <div class="mt-3">
                <h5>Test Results:</h5>
                <div class="alert @(_success ? "alert-success" : "alert-danger")">
                    @foreach (var log in _logs)
                    {
                        <div>@log</div>
                    }
                </div>
            </div>
        }

        @if (_embeddings.Any())
        {
            <div class="mt-3">
                <h5>Generated Embeddings:</h5>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Text</th>
                            <th>Embedding Size</th>
                            <th>First 5 Values</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _embeddings.Count && i < _testTexts.Length; i++)
                        {
                            var embedding = _embeddings[i];
                            <tr>
                                <td><code>@_testTexts[i]</code></td>
                                <td>@embedding.Length dimensions</td>
                                <td>
                                    <small>
                                        [@string.Join(", ", embedding.Span.Slice(0, 5).ToArray().Select(v => v.ToString("F3")))]...
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_isMatching)
        {
            <div class="mt-3">
                <h5>Semantic Matching Progress:</h5>
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         style="width: @(_matchingProgress?.PercentComplete ?? 0)%">
                        @(_matchingProgress?.PercentComplete ?? 0)%
                    </div>
                </div>
                <div class="mt-2">
                    <small class="text-muted">
                        @_matchingProgress?.Stage: @_matchingProgress?.Message
                    </small>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_matchResult))
        {
            <div class="mt-3">
                <h5>Semantic Matching Test:</h5>
                <div class="alert alert-info">
                    <strong>Query:</strong> "Sports Volunteering"<br/>
                    <strong>Candidates:</strong> Sport, Education, Technology<br/>
                    <strong>Result:</strong> @_matchResult
                </div>
            </div>
        }
    </div>
</div>
